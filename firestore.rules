rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function isValidDateKey(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // User Profile: /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 256;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Habits subcollection: /users/{userId}/habits/{habitId}
      match /habits/{habitId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(habitId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 160
          && request.resource.data.category is string
          && request.resource.data.habitType in ['binary', 'measurable']
          && request.resource.data.targetValue is number
          && request.resource.data.targetValue >= 0;
        allow update: if isOwner(userId)
          && isValidId(habitId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 160
          && request.resource.data.habitType in ['binary', 'measurable']
          && request.resource.data.targetValue is number;
        allow delete: if isOwner(userId) && isValidId(habitId);
      }

      // Completions subcollection: /users/{userId}/completions/{completionId}
      match /completions/{completionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(completionId)
          && request.resource.data.userId == userId
          && request.resource.data.habitId is string
          && isValidId(request.resource.data.habitId)
          && isValidDateKey(request.resource.data.dateKey)
          && request.resource.data.status in ['completed', 'partial', 'skipped']
          && request.resource.data.progressValue is number
          && request.resource.data.targetValue is number;
        allow update: if isOwner(userId)
          && isValidId(completionId)
          && request.resource.data.userId == userId
          && request.resource.data.habitId == resource.data.habitId
          && request.resource.data.dateKey == resource.data.dateKey
          && request.resource.data.status in ['completed', 'partial', 'skipped']
          && request.resource.data.progressValue is number;
        allow delete: if isOwner(userId) && isValidId(completionId);
      }

      // Tasks subcollection: /users/{userId}/tasks/{taskId}
      match /tasks/{taskId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(taskId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.priority in ['low', 'medium', 'high', 'urgent']
          && request.resource.data.completed is bool;
        allow update: if isOwner(userId)
          && isValidId(taskId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200;
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // Notes subcollection: /users/{userId}/notes/{noteId}
      match /notes/{noteId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(noteId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 20000;
        allow update: if isOwner(userId)
          && isValidId(noteId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 20000;
        allow delete: if isOwner(userId) && isValidId(noteId);
      }

      // Settings subcollection: /users/{userId}/settings/{settingId}
      match /settings/{settingId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(settingId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(settingId);
      }
    }
  }
}
